{
  "name": "lex-au-explorer-web",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predeploy": "node scripts/predeploy.mjs",
    "restore-fixtures": "git checkout -- public/data",
    "deploy": "npm run predeploy && npm run build && (cd .. && netlify deploy --prod --dir=web/dist) && npm run restore-fixtures",
    "verify-corpus": "node scripts/verify-corpus-data.mjs",
    "build": "npm run verify-corpus && vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.0"
  }
}
