{
  "name": "lex-au-explorer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predeploy": "cd .. && .venv/bin/lex-au-explorer-build --corpus-dir ../../lex-au/repo/corpus --graph ../../lex-au-graph/repo/graph.json --out web/public/data",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.10.6",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.0"
  }
}
